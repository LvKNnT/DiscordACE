{
  "manifest_version": 3,
  "name": "DiscordACE helper",
  "version": "2.0.2",
  "description": "Read-only Discord Web helpers for KingVietnamese, CountNum, LinkingWord, and Wordle.",
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "action": {
    "default_title": "DiscordACE helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/channels/*"],
      "js": ["games.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Viet74K.txt", "english-words.txt", "panel.css"],
      "matches": ["https://discord.com/*"]
    }
  ]
}
